#:kivy 2.3.0
#:import StencilPush kivy.graphics.StencilPush
#:import StencilUse kivy.graphics.StencilUse
#:import StencilUnUse kivy.graphics.StencilUnUse
#:import StencilPop kivy.graphics.StencilPop

#button classes
<GnButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: ((0xC6/255, 0xC6/255, 0xC6/255, 0.5) if self.disabled else (0xC6/255, 0xC6/255, 0xC6/255, 1))
    font_name: "Jua"
    font_size: "28sp"

    canvas.before:
        Color: 
            rgba: ((0x31/255, 0x3D/255, 0x38/255, 0.5) if self.disabled else ((0x3F/255, 0x51/255, 0x4A/255, 1) if self.state == "down" else (0x31/255, 0x3D/255, 0x38/255, 1)))

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]
<TButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0xC6/255, 0xC6/255, 0xC6/255, 1
    font_name: "Jua"
    font_size: "30sp"

    canvas.before:
        Color: 
            rgb: (0x40/255, 0x55/255, 0x58/255) if self.state == "down" else (0x30/255, 0x3D/255, 0x3F/255)

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]
<TBButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0xC6/255, 0xC6/255, 0xC6/255, 1
    font_name: "Jua"
    font_size: "30sp"

    canvas.before:
        Color: 
            rgb: (0x3D/255, 0x4B/255, 0x54/255) if self.state == "down" else (0x2F/255, 0x3C/255, 0x43/255)

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]
<BButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0xC6/255, 0xC6/255, 0xC6/255, 1
    font_name: "Jua"
    font_size: "30sp"

    canvas.before:
        Color: 
            rgb: 
                (0x3D/255, 0x4E/255, 0x61/255) if self.state == "down" else (0x2D/255, 0x3A/255, 0x47/255) 

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]
<PButton@Button>:
    highlighted: self.state == "down"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0xC6/255, 0xC6/255, 0xC6/255, 1
    font_name: "Jua"
    font_size: "27sp"

    canvas.before:
        Color:
            rgb: (0x4D/255, 0x52/255, 0x6E/255) if self.highlighted else (0x38/255, 0x3B/255, 0x50/255)

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]
<GButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0xC6/255, 0xC6/255, 0xC6/255, 1
    font_name: "Jua"
    font_size: "40sp"

    canvas.before:
        Color: 
            rgb: (0x6E/255, 0x6E/255, 0x6E/255) if self.state == "down" else (0x52/255, 0x52/255, 0x52/255)

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]

<LayerDialogButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0xC6/255, 0xC6/255, 0xC6/255, 1
    font_name: "Jua"
    font_size: "23sp"

    canvas.before:
        Color:
            rgb: (.40, .40, .40) if self.state == "down" else (.33, .33, .33)

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
<LayerNameRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(44)
    spacing: dp(8)

    Label:
        text: str(int(root.layer_number)) + ":"
        font_name: "Jua"
        font_size: "19sp"
        color: 0xC6/255, 0xC6/255, 0xC6/255, 1
        size_hint_x: None
        width: max(dp(30), self.texture_size[0] + dp(4))

    BoxLayout:
        canvas.before:
            Color:
                rgb: 0x1C/255, 0x1C/255, 0x1C/255

            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(7)]

            Color:
                rgba: 1, 1, 1, 1

        TextInput:
            id: name_input
            text: root.layer_name
            readonly: False
            multiline: False
            font_name: "Console"
            font_size: "16sp"
            padding: dp(12), dp(10)
            foreground_color: 0xC6/255, 0xC6/255, 0xC6/255, 1
            cursor_color: 0xC6/255, 0xC6/255, 0xC6/255, 1
            background_normal: ""
            background_active: ""
            background_color: 0, 0, 0, 0
<LayerNamesPopup>:
    size_hint: None, None
    width: min(dp(320), app.root.width - dp(44))
    height: min(dp(420), app.root.height - dp(44))
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, .65

    BoxLayout:
        orientation: "vertical"
        padding: dp(18), dp(10), dp(18), dp(14)
        spacing: dp(10)

        canvas.before:
            Color:
                rgb: 0x30/255, 0x30/255, 0x30/255

            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12)]

            Color:
                rgb: 0x46/255, 0x46/255, 0x46/255

            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
                width: dp(1.4)

        Label:
            text: "Edit Layer Names"
            font_name: "Jua"
            font_size: "24sp"
            color: 0xC6/255, 0xC6/255, 0xC6/255, 1
            size_hint_y: None
            height: dp(28)

        Widget:
            size_hint_y: None
            height: dp(2)

            canvas:
                Color:
                    rgb: 0xC6/255, 0xC6/255, 0xC6/255

                Rectangle:
                    pos: self.x, self.center_y
                    size: self.width, dp(1)
        ScrollView:
            id: layer_scroll
            do_scroll_x: False
            bar_width: dp(3)

            BoxLayout:
                id: layer_fields
                orientation: "vertical"
                spacing: dp(7)
                padding: dp(3), dp(2), dp(12), dp(2)
                size_hint_y: None
                height: self.minimum_height
        AnchorLayout:
            size_hint_y: None
            height: dp(30)

            LayerDialogButton:
                text: "+"
                font_size: "28sp"
                size_hint: None, None
                size: dp(58), dp(30)
                on_release: app.add_layer_row(root)

        Label:
            id: error_message
            text: ""
            font_name: "Jua"
            font_size: "14sp"
            color: 1, .6, .6, 1
            text_size: self.width, None
            size_hint_y: None
            height: max(dp(22), self.texture_size[1])

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(12)
            padding: dp(12), 0

            LayerDialogButton:
                text: "Cancel"
                on_release: root.dismiss()

            LayerDialogButton:
                text: "Save"
                on_release: app.save_layer_names(root)
#splash screen
<SplashScreen>:
    FloatLayout:

        canvas.before:
            Color:
                rgb: 0x1C/255, 0x1C/255, 0x1C/255
            Rectangle:
                pos: self.pos
                size: self.size

        Image:
            source: "assets/presplash.png"
            fit_mode: "contain"
            size_hint: 1, 1
#main screen
<MainScreen>:

    BoxLayout:

        canvas.before:
            Color:
                rgb: 0x30/255, 0x30/255, 0x30/255
            Rectangle:
                pos: self.pos
                size: self.size
        orientation: "vertical"
        padding: "22dp"
        spacing: "13dp"
    # buttons
        BoxLayout:
            size_hint_y: None
            height: "53dp"
            spacing: "14dp"

            GnButton:
                text: "Sync CSV"
                on_release: app.sync_csv_pressed()

            GnButton:
                id: csv_button
                text: "Open CSV"
                on_release: app.csv_pressed()
        BoxLayout:
            size_hint_y: None
            height: "45dp"

            TBButton:
                text: "Playlist"
                on_release: app.playlist_pressed()
    # divider    
        Widget:
            size_hint_y: None
            height: "5dp"

            canvas:
                Color:
                    rgb: 1, 1, 1

                Rectangle:
                    pos: self.x, self.center_y - dp(0.9)
                    size: self.width, dp(1.5)
    # settings row   
        BoxLayout:
            size_hint_y: None
            height: "50dp"
            spacing: "14dp"

            PButton:
                text: ""
                size_hint_x: None
                width: dp(53)
                highlighted: app.adb_report_mode
                on_release: app.toggle_adb_reporting()

                Image:
                    source: "assets/adb.png"
                    size_hint: None, None
                    size: dp(25), dp(25)
                    center: self.parent.center
                    opacity: 0.5 if self.parent.disabled else 1

            PButton:
                text: "Edit Layer Names"
                on_release: app.edit_layers_pressed()
    # progress bars
        BoxLayout:
            orientation: "vertical"
            canvas.before:
                Color:
                    rgb: 0x1C/255, 0x1C/255, 0x1C/255

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(4)]
            BoxLayout:
                size_hint_y: None
                height: "22dp"
                padding: "7dp", "3dp"
                ProgressBarWidget:
                    id: progress

                    size_hint: 1, None
                    height: "12dp"

                    canvas.before:
                        Color:
                            rgb: 0x27/255, 0x27/255, 0x27/255

                        RoundedRectangle:
                            pos: progress.pos
                            size: progress.size
                            radius: [dp(4)]

                        # Filled portion
                        StencilPush

                        RoundedRectangle:
                            pos: progress.pos
                            size: progress.fill_width, progress.height
                            radius: [dp(4)]

                        StencilUse

                        Color:
                            rgba: (1, 1, 1, 1) if progress.show_fill else (1, 1, 1, 0)

                        Rectangle:
                            texture: app.gradient
                            tex_coords:
                                (0, 0,
                                1, 0,
                                1, 1,
                                0, 1)

                            pos: progress.pos
                            size: progress.size

                        StencilUnUse

                        RoundedRectangle:
                            pos: progress.pos
                            size: progress.fill_width, progress.height
                            radius: [dp(4)]

                        StencilPop
                Label:
                    id: progress_label
                    size_hint_x: None
                    width: self.texture_size[0]
                    padding: "6dp", "3dp", "0dp", "0dp"
                    pos_hint: {"right": .995, "top": .995}
                    halign: "center"
                    font_name: "Jua"
                    font_size: "14sp"
                    text: root.progress_text
            ScrollView:
                id: console_scroll
                do_scroll_x: False
                TextInput:
                    id: console

                    readonly: True
                    multiline: True

                    font_name: "Console"
                    font_size: "18sp"

                    text: ""

                    padding: "12dp", "12dp"

                    size_hint_y: None
                    height: max(self.minimum_height, self.line_height)

                    width: self.parent.width

                    background_color: 0, 0, 0, 0
                    foreground_color: 1, 1, 1, 1

                    cursor_width: 0
                    cursor_blink: False

                    use_bubble: True
                    use_handles: True
        Widget:
            size_hint_y: None
            height: "5dp"

            canvas:
                Color:
                    rgb: 1, 1, 1

                Rectangle:
                    pos: self.x, self.center_y - dp(0.9)
                    size: self.width, dp(1.5)
    # grey buttons
        FloatLayout:
            size_hint_y: None
            height: "81dp"

            BoxLayout:
                id: paste_buttons
                pos_hint: {"x": 0, "y": 0}

                GButton:
                    text: "Paste"
                    on_release: app.paste_pressed()
            BoxLayout:
                id: yesno_buttons
                spacing: "10dp"
                pos_hint: {"x": 0, "y": 0}

                GButton:
                    text: "Y"
                    on_release: app.yes_pressed()
                GButton:
                    text: "N"
                    on_release: app.no_pressed()

            BoxLayout:
                id: continue_buttons
                pos_hint: {"x": 0, "y": 0}

                GButton:
                    text: "Continue"
                    on_release: app.continue_pressed()
            BoxLayout:
                id: abort_buttons
                pos_hint: {"x": 0, "y": 0}

                GButton:
                    text: "Abort Process"
                    on_release: app.abort_pressed()
            BoxLayout:
                id: idle_buttons
                pos_hint: {"x": 0, "y": 0}

                GButton:
                    text: ""
                    on_release: app.machine.log(""),app.machine.log(":3")

            

Root:
    SplashScreen:
        name: "splash"

    MainScreen:
        name: "main"

